# Use the pooled or direct PostgreSQL connection string supplied by Neon, Supabase,
# Railway, Render, or another managed PostgreSQL provider. Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Create unique secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-48-byte-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-48-byte-random-secret"

PORT=4000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5000,http://localhost:3000"
UPLOAD_DIRECTORY="./uploads"
MAX_UPLOAD_BYTES=10485760

# Optional. Enables Firebase Cloud Messaging push delivery. Store the complete
# Firebase service-account JSON as a single-line JSON value. Never expose this
# secret to Flutter or commit it to source control.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Required only when creating the initial staff account with npm run db:seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
