generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentKind {
  ID_FRONT
  ID_BACK
  SELFIE
  SIGNATURE
}

enum PaymentStatus {
  DUE
  PAID
  OVERDUE
  WAIVED
}

enum TransactionType {
  LOAN_DISBURSEMENT
  REPAYMENT
  WITHDRAWAL
  DEPOSIT
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique @db.VarChar(254)
  passwordHash   String
  fullName       String
  idNumber       String?        @unique
  phone          String?        @db.VarChar(30)
  dateOfBirth    DateTime?       @db.Date
  gender         String?        @db.VarChar(40)
  address        String?
  profilePhotoUrl String?
  role           UserRole       @default(CUSTOMER)
  isActive       Boolean        @default(true)
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  lastLogoutAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  loans          Loan[]
  transactions   Transaction[]  @relation("AccountTransactions")
  reviewedTransactions Transaction[] @relation("TransactionReviewer")
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditEvents    AuditLog[]     @relation("AuditActor")
  permissionOverrides UserPermission[]
  deviceTokens   DeviceToken[]
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id                   String       @id @default(uuid()) @db.Uuid
  loanNumber           String       @unique
  status               LoanStatus   @default(PENDING)
  currency             String       @default("PHP") @db.VarChar(3)
  principal            Decimal      @db.Decimal(14, 2)
  termMonths           Int
  monthlyInterestRate  Decimal      @db.Decimal(7, 6)
  interestAmount       Decimal      @db.Decimal(14, 2)
  totalRepayment       Decimal      @db.Decimal(14, 2)
  monthlyPayment       Decimal      @db.Decimal(14, 2)
  acceptedTermsAt      DateTime
  actualName           String
  idCardNumber         String
  currentJob           String
  gender               String
  stableIncome         Decimal      @db.Decimal(14, 2)
  loanPurpose          String
  currentAddress       String
  guarantorName        String
  guarantorPhone       String
  beneficiaryBank      String
  accountName          String
  accountNumber        String
  reviewerNote         String?
  reviewedAt           DateTime?
  disbursedAt          DateTime?
  submittedAt          DateTime?
  informationRequestedAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  borrowerId           String       @db.Uuid
  borrower             User         @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  productId            String?      @db.Uuid
  product              LoanProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  documents            LoanDocument[]
  repayments           Repayment[]
  transactions         Transaction[]

  @@index([borrowerId, createdAt])
  @@index([status, createdAt])
  @@index([submittedAt, status, createdAt])
  @@index([productId])
}

model LoanDocument {
  id          String       @id @default(uuid()) @db.Uuid
  kind        DocumentKind
  storageKey  String       @unique
  url         String       @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime     @default(now())
  loanId      String       @db.Uuid
  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, kind])
}

model Repayment {
  id          String        @id @default(uuid()) @db.Uuid
  installment Int
  dueDate     DateTime
  principal   Decimal       @db.Decimal(14, 2)
  interest    Decimal       @db.Decimal(14, 2)
  amountDue   Decimal       @db.Decimal(14, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(14, 2)
  paidAt      DateTime?
  status      PaymentStatus @default(DUE)
  loanId      String        @db.Uuid
  loan        Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installment])
  @@index([loanId, dueDate])
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  amount       Decimal           @db.Decimal(14, 2)
  currency     String            @default("PHP") @db.VarChar(3)
  description  String
  reviewReason String?
  reviewedAt   DateTime?
  occurredAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  userId       String            @db.Uuid
  loanId       String?           @db.Uuid
  reviewedById String?           @db.Uuid
  loan         Loan?             @relation(fields: [loanId], references: [id], onDelete: SetNull)
  user         User              @relation("AccountTransactions", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy   User?             @relation("TransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([loanId, occurredAt])
  @@index([status, type, occurredAt])
  @@index([reviewedById, reviewedAt])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  payload   String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model LoanProduct {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique @db.VarChar(32)
  name                  String
  description           String
  currency              String   @default("PHP") @db.VarChar(3)
  minimumAmount         Decimal  @db.Decimal(14, 2)
  maximumAmount         Decimal  @db.Decimal(14, 2)
  monthlyInterestRate   Decimal  @db.Decimal(7, 6)
  allowedTerms          Int[]
  repaymentFrequency    String   @default("MONTHLY") @db.VarChar(20)
  isActive              Boolean  @default(true)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  loans                 Loan[]

  @@index([isActive, isDefault])
}

model Branch {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String
  address     String
  phone       String
  email       String?  @db.VarChar(254)
  managerName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(80)
  name            String           @db.VarChar(120)
  description     String?
  category        String           @db.VarChar(80)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roleAssignments RolePermission[]
  userAssignments UserPermission[]

  @@index([category, sortOrder])
}

model RolePermission {
  role         UserRole
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String     @db.Uuid
  permissionId String     @db.Uuid
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  platform   String   @db.VarChar(24)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}
